# Sign-in is username/password, not a shared secret. Set up your account
# with `npm run create-account -w server` (interactive, recommended), or
# bootstrap it non-interactively by setting both of these once — the server
# hashes ADMIN_PASSWORD into server/data/account.json on first boot and you
# can then blank this out again:
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Port the server listens on.
PORT=4317

# Root directory the web UI is allowed to browse and create local sessions
# in. Defaults to your home directory if unset. Sessions can only be
# created inside this directory (no path traversal above it). Irrelevant
# for sessions targeting a runner — see runner/.env.example instead.
WORKSPACE_ROOT=

# Default permission mode passed to `claude` for new local sessions.
# One of: acceptEdits, bypassPermissions, dontAsk, plan, manual, auto
# acceptEdits is a reasonable default: file edits are auto-approved but this
# still relies on Claude Code's own tool-permission logic for riskier actions.
DEFAULT_PERMISSION_MODE=acceptEdits

# Optional: pin a specific model alias/name for new sessions (e.g. sonnet, opus).
DEFAULT_MODEL=

# Email notifications for `highwayman-server start` (connection info: local/
# public URL, connect command, sign-in usernames — never passwords) and
# `highwayman-server mail <email...>`. These are SECRETS — set them here
# (server/.env is git-ignored) or directly in your own shell environment;
# never commit real values. Everyone who runs highwayman-server sets their
# own. Left unset, `start` just prints a warning and skips the email —
# nothing else changes.
#
# Defaults assume Gmail SMTP. With 2FA on, SMTP_PASS must be an App
# Password (https://myaccount.google.com/apppasswords), not your normal one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Optional: defaults to SMTP_USER if unset.
MAIL_FROM=

# Optional default recipient list for `highwayman-server start` — comma-
# separated for more than one. `highwayman-server mail <email...>` (or
# `start --to <emails>`) sends to specific addresses on demand instead.
MAIL_TO=
