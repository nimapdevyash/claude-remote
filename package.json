{
  "name": "claude-remote",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client",
    "runner",
    "docs"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "runner": "npm run start -w runner",
    "docs:dev": "npm run dev -w docs",
    "docs:build": "npm run build -w docs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
