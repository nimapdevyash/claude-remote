# All of these are optional. If unset, the first run of
# `highwayman` will ask for them interactively and remember your
# answers in ~/.highwayman/config.json. Set them here instead if
# you want a fully non-interactive/headless setup (e.g. systemd, Docker).
# Run `highwayman setup` at any time to be asked again.
#
# SERVER_URL specifically is worth calling out: it IS remembered, but every
# run that doesn't set this (or pass --server) asks a quick "connect to a
# different server this time?" instead of silently reusing it — since it's
# often an ngrok-style tunnel URL that changes on restart. Setting it here
# skips that question entirely, useful for headless setups.

# WebSocket URL of the highwayman server. Use ws:// on a trusted local
# network, or wss:// when connecting through a TLS tunnel (e.g. ngrok).
SERVER_URL=ws://localhost:4317/ws

# Directory on THIS machine that Claude Code is allowed to read, write, and
# run shell commands in. Every path and command is confined to this folder.
ROOT=

# Display name shown in the web UI's "run on" picker (defaults to hostname).
NAME=

# Sign-in is still username/password (prompted interactively, then cached
# in ~/.highwayman/session) — there is no token to put here.
