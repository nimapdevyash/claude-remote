# All of these are optional. ROOT and NAME, if unset, are asked for once
# interactively and remembered in ~/.claude-remote-runner/config.json. Set
# them here instead if you want a fully non-interactive/headless setup
# (e.g. systemd, Docker). Run `claude-remote-runner setup` at any time to be
# asked again.
#
# SERVER_URL is different: it's never remembered, since it's typically an
# ngrok-style tunnel URL that changes on every restart. Set it here for a
# headless setup, or expect to pass --server / be prompted for it on every
# run otherwise.

# WebSocket URL of the claude-remote server. Use ws:// on a trusted local
# network, or wss:// when connecting through a TLS tunnel (e.g. ngrok).
SERVER_URL=ws://localhost:4317/ws

# Directory on THIS machine that Claude Code is allowed to read, write, and
# run shell commands in. Every path and command is confined to this folder.
ROOT=

# Display name shown in the web UI's "run on" picker (defaults to hostname).
NAME=

# Sign-in is still username/password (prompted interactively, then cached
# in ~/.claude-remote-runner/session) — there is no token to put here.
